node_modules
.expo
dist

# Generated by `npm run prebuild` from app.json, which is the source of truth.
# Regenerate rather than editing: a hand-edited project is silently discarded
# by the next --clean prebuild.
/ios
/android

# Signing material produced by tools/make-ios-dist-cert.sh. The private key
# and .p12 in here can sign software as you; they belong in a password
# manager and in GitHub Actions secrets, never in a commit.
.secrets/

# Crash dumps
core.*

# Windows/WSL download artifacts
*:Zone.Identifier

# Dataset checkouts (large, fetched separately) and the video symlink/copy
# testing/tools/prepare-test-data.mjs stages from the selected one.
test-data/
public/

test-results/
playwright-report/
dist-perf/
