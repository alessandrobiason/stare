+  /// Watches for the session being taken away, and takes it back.
+  ///
+  /// `AVCaptureSession` is interrupted for reasons that have nothing to do with
+  /// the app — another client on the camera, several foreground apps, system
+  /// pressure — and nothing here was listening. An interrupted session stops
+  /// delivering to the preview and refuses every capture with
+  /// AVErrorSessionNotRunning (-11803), and because no one restarts it when the
+  /// interruption ends, it stays that way for the life of the view: a black
+  /// preview and a camera that never captures again.
+  ///
+  /// The reason is also kept, because "interrupted" is a symptom and the reason
+  /// is the cause, and a capture failure has no other way to report it.
+  func observeInterruptions() {
+    interruptionTask?.cancel()
+    interruptionTask = Task { [weak self] in
+      guard let session = self?.session else {
+        return
+      }
+      async let started: Void = {
+        let notes = NotificationCenter.default.notifications(
+          named: .AVCaptureSessionWasInterrupted, object: session)
+        for await note in notes {
+          let raw = (note.userInfo?[AVCaptureSessionInterruptionReasonKey] as? Int) ?? -1
+          CameraSessionDiagnostics.lastInterruption = "\(raw) \(CameraSessionDiagnostics.name(forReason: raw))"
+          NSLog("expo-camera: capture session interrupted, reason %@", CameraSessionDiagnostics.lastInterruption)
+        }
+      }()
+      async let ended: Void = {
+        let notes = NotificationCenter.default.notifications(
+          named: .AVCaptureSessionInterruptionEnded, object: session)
+        for await _ in notes {
