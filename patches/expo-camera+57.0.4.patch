+  /// The capture failure, in enough detail to tell the causes apart.
+  ///
+  /// Everything reachable from the delegate callback without adding state:
+  /// what AVFoundation said, whether the session was running or interrupted at
+  /// the time, whether the video connection was live, and how the output and
+  /// the device were configured. A capture that fails on someone else's phone
+  /// is otherwise a single fixed string shared by every possible cause.
+  private func describeCaptureFailure(error: Error, output: AVCapturePhotoOutput) -> String {
+    let nsError = error as NSError
+    var parts = ["\(nsError.domain) \(nsError.code) \(nsError.localizedDescription)"]
+
+    parts.append("iOS=\(UIDevice.current.systemVersion)")
+
+    if let session = captureDelegate?.previewLayer.session {
+      parts.append("running=\(session.isRunning ? 1 : 0)")
+      parts.append("interrupted=\(session.isInterrupted ? 1 : 0)")
+      parts.append("preset=\(session.sessionPreset.rawValue)")
+      parts.append("inputs=\(session.inputs.count)")
+      parts.append("outputs=\(session.outputs.count)")
+    }
+    if let previewSize = captureDelegate?.previewLayer.frame.size {
+      parts.append("preview=\(Int(previewSize.width))x\(Int(previewSize.height))")
+    }
+
+    if let connection = output.connection(with: .video) {
+      parts.append("connection=\(connection.isEnabled ? "on" : "off")/\(connection.isActive ? "active" : "inactive")")
+      if let input = connection.inputPorts.first?.input as? AVCaptureDeviceInput {
+        let format = CMVideoFormatDescriptionGetDimensions(input.device.activeFormat.formatDescription)
+        parts.append("device=\(input.device.localizedName)")
+        parts.append("activeFormat=\(format.width)x\(format.height)")
+
+        // The list the requested dimensions have to be a member of. If the
+        // requested value is not in here, AVFoundation refuses the request —
+        // which is the shape of a failure that costs no time at all.
+        if #available(iOS 16.0, *) {
+          let supported = input.device.activeFormat.supportedMaxPhotoDimensions
+            .map { "\($0.width)x\($0.height)" }
+            .joined(separator: "/")
+          parts.append("supportedMaxPhotoDimensions=[\(supported)]")
+        }
+      }
+    }
+
+    if #available(iOS 16.0, *) {
+      let dimensions = output.maxPhotoDimensions
+      parts.append("maxPhotoDimensions=\(dimensions.width)x\(dimensions.height)")
+    }
+    if #available(iOS 17.0, *) {
+      parts.append("deferred=\(output.isAutoDeferredPhotoDeliveryEnabled ? 1 : 0)")
+      parts.append("responsive=\(output.isResponsiveCaptureEnabled ? 1 : 0)")
+      parts.append("fastPriority=\(output.isFastCapturePrioritizationEnabled ? 1 : 0)")
+      parts.append("zeroShutterLag=\(output.isZeroShutterLagEnabled ? 1 : 0)")
+    }
+
+    return parts.joined(separator: ", ")
+  }
