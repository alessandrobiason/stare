@@ -0,0 +1,310 @@
+import Accelerate
+@preconcurrency import AVFoundation
+import CoreVideo
+import ExpoModulesCore
+
+internal final class CameraFrameTapUnavailableException: Exception {
+  override var reason: String {
+    "The capture session cannot deliver video frames"
+  }
+}
+
+internal final class CameraFrameTapTimeoutException: Exception {
+  override var reason: String {
+    "No video frame arrived in time"
+  }
+}
+
+/// The session is stopped or interrupted — the phone locked, the app in the
+/// background, another app on the camera. Not the tap's fault, and not a frame
+/// that timed out: reported at once, and separately, so a caller can wait it out
+/// rather than count it against the tap.
+internal final class CameraFrameTapNotRunningException: Exception {
+  override var reason: String {
+    "The capture session is not running"
+  }
+}
+
+internal final class CameraFrameTapBusyException: Exception {
+  override var reason: String {
+    "A video frame is already being taken"
+  }
+}
+
+internal final class CameraFrameTapFrameException: GenericException<String> {
+  override var reason: String {
+    "The video frame could not be read: \(param)"
+  }
+}
+
+/// A copy of the frame the preview is showing, at a small size, for code that
+/// reads the camera rather than photographs with it.
+///
+/// `takePictureAsync` is the wrong tool for that. Every call is a full-resolution
+/// still through the photo pipeline — multi-frame fusion on the ISP, the GPU and
+/// the Neural Engine — then a HEIC decode, a crop and a full-resolution JPEG
+/// encode and decode in this library, all to be resampled to a few hundred
+/// pixels a side by the caller. Once a second that is enough to hitch the
+/// preview itself, and it competes with anything else on the Neural Engine.
+///
+/// The preview is already producing frames. This adds a video data output to
+/// the same session, leaves its connection disabled so nothing is delivered
+/// while no one is asking, and enables it for one frame per request: the frame
+/// is cropped to the preview's shape, scaled, turned upright the way the preview
+/// is, and handed back as RGBA. No still, no encode, no file, and a frame at
+/// most one or two video frames after the request.
+///
+/// `@unchecked Sendable` because every piece of mutable state is confined to a
+/// queue: `output` to the session queue, the pending request to `queue`.
+final class CameraFrameTap: NSObject, AVCaptureVideoDataOutputSampleBufferDelegate, @unchecked Sendable {
+  /// What a request asks for.
+  struct Target {
+    let width: Int
+    let height: Int
+    /// Clockwise degrees the preview's own connection turns its frames by.
+    let rotationAngle: Int
+    /// The preview's width over its height, as it is shown.
+    let aspect: CGFloat
+  }
+
+  private struct Pending {
+    let id: Int
+    let target: Target
+    let continuation: CheckedContinuation<NativeArrayBuffer, Error>
+  }
+
+  private let session: AVCaptureSession
+  private let sessionQueue: DispatchQueue
+  /// Where frames arrive, and the only place `pending` and `nextID` are touched.
+  private let queue = DispatchQueue(label: "expo.camera.frameTap", qos: .userInitiated)
+  /// Touched on the session queue only.
+  private var output: AVCaptureVideoDataOutput?
+  private var pending: Pending?
+  private var nextID = 0
+
+  init(session: AVCaptureSession, sessionQueue: DispatchQueue) {
+    self.session = session
+    self.sessionQueue = sessionQueue
+    super.init()
+  }
+
+  func grab(target: Target, timeout: TimeInterval) async throws -> NativeArrayBuffer {
+    return try await withCheckedThrowingContinuation { continuation in
+      queue.async {
+        guard self.pending == nil else {
+          continuation.resume(throwing: CameraFrameTapBusyException())
+          return
+        }
+        self.nextID += 1
+        let id = self.nextID
+        self.pending = Pending(id: id, target: target, continuation: continuation)
+
+        self.sessionQueue.async {
+          // Checked here rather than when the request was made: this block runs
+          // behind whatever the session queue was already doing, and after the
+          // phone is unlocked that is the session being started again, which
+          // takes a second or two. Asked before it, a running session looked
+          // stopped; timed from before it, a healthy tap timed out.
+          guard self.session.isRunning, !self.session.isInterrupted else {
+            self.queue.async {
+              self.finish(id, with: .failure(CameraFrameTapNotRunningException()))
+            }
+            return
+          }
+          guard let output = self.attachedOutput() else {
+            self.queue.async {
+              self.finish(id, with: .failure(CameraFrameTapUnavailableException()))
+            }
+            return
+          }
+          output.connection(with: .video)?.isEnabled = true
+          // The wait starts once frames can flow, not when they were asked for.
+          self.queue.asyncAfter(deadline: .now() + timeout) {
+            self.finish(id, with: .failure(CameraFrameTapTimeoutException()))
+          }
+        }
+      }
+    }
+  }
+
+  /// The output, added to the session the first time it is needed and again if
+  /// the session has been taken apart since. Must be called on the session queue.
+  private func attachedOutput() -> AVCaptureVideoDataOutput? {
+    if let output, session.outputs.contains(output) {
+      return output
+    }
+    let output = AVCaptureVideoDataOutput()
+    // BGRA as the barcode scanner in this library asks for it, so the colour
+    // conversion is the capture pipeline's own. The connection is off except
+    // while a frame is wanted, so it converts nothing the rest of the time.
+    output.videoSettings = [kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatType_32BGRA]
+    output.alwaysDiscardsLateVideoFrames = true
+    output.setSampleBufferDelegate(self, queue: queue)
+
+    session.beginConfiguration()
+    defer { session.commitConfiguration() }
+    guard session.canAddOutput(output) else {
+      return nil
+    }
+    session.addOutput(output)
+    output.connection(with: .video)?.isEnabled = false
+    self.output = output
+    return output
+  }
+
+  /// Resolves request `id` if it is still the one waiting, and turns delivery off.
+  private func finish(_ id: Int, with result: Result<NativeArrayBuffer, Error>) {
+    guard let pending, pending.id == id else {
+      return
+    }
+    self.pending = nil
+    disableDelivery()
+    pending.continuation.resume(with: result)
+  }
+
+  /// Called on `queue`. A request made after this enqueues its own enable from
+  /// the same serial queue, so it lands on the session queue after this disable
+  /// and never before it.
+  private func disableDelivery() {
+    sessionQueue.async {
+      self.output?.connection(with: .video)?.isEnabled = false
+    }
+  }
+
+  func captureOutput(
+    _ output: AVCaptureOutput,
+    didOutput sampleBuffer: CMSampleBuffer,
+    from connection: AVCaptureConnection
+  ) {
+    guard let pending else {
+      return
+    }
+    guard let pixelBuffer = CMSampleBufferGetImageBuffer(sampleBuffer) else {
+      return
+    }
+    do {
+      let pixels = try Self.render(
+        pixelBuffer,
+        bufferAngle: Self.rotationAngle(of: connection),
+        target: pending.target
+      )
+      finish(pending.id, with: .success(pixels))
+    } catch {
+      finish(pending.id, with: .failure(error))
+    }
+  }
+
+  /// A connection's rotation, as clockwise degrees: 0 is the sensor's own
+  /// landscape, 90 is portrait on the back camera.
+  static func rotationAngle(of connection: AVCaptureConnection) -> Int {
+    if #available(iOS 17.0, *) {
+      return (Int(connection.videoRotationAngle.rounded()) % 360 + 360) % 360
+    }
+    switch connection.videoOrientation {
+    case .portrait:
+      return 90
+    case .landscapeLeft:
+      return 180
+    case .portraitUpsideDown:
+      return 270
+    default:
+      return 0
+    }
+  }
+
+  /// The largest centred crop of the preview's shape, scaled to the target and
+  /// turned the rest of the way to the preview's rotation, as RGBA.
+  private static func render(_ pixelBuffer: CVPixelBuffer, bufferAngle: Int, target: Target) throws -> NativeArrayBuffer {
+    guard CVPixelBufferGetPixelFormatType(pixelBuffer) == kCVPixelFormatType_32BGRA else {
+      throw CameraFrameTapFrameException("pixel format \(CVPixelBufferGetPixelFormatType(pixelBuffer))")
+    }
+    guard target.width > 0, target.height > 0, target.aspect > 0 else {
+      throw CameraFrameTapFrameException("target \(target.width)x\(target.height)")
+    }
+
+    CVPixelBufferLockBaseAddress(pixelBuffer, .readOnly)
+    defer { CVPixelBufferUnlockBaseAddress(pixelBuffer, .readOnly) }
+    guard let base = CVPixelBufferGetBaseAddress(pixelBuffer) else {
+      throw CameraFrameTapFrameException("no base address")
+    }
+    let bufferWidth = CVPixelBufferGetWidth(pixelBuffer)
+    let bufferHeight = CVPixelBufferGetHeight(pixelBuffer)
+    let bytesPerRow = CVPixelBufferGetBytesPerRow(pixelBuffer)
+
+    // How much further the buffer has to turn to face the way the preview does,
+    // and so which way round the preview's shape lies across the unturned buffer.
+    let turn = ((target.rotationAngle - bufferAngle) % 360 + 360) % 360
+    let sideways = turn == 90 || turn == 270
+    let scaledWidth = sideways ? target.height : target.width
+    let scaledHeight = sideways ? target.width : target.height
+    let aspect = sideways ? 1 / target.aspect : target.aspect
+
+    // What an aspect-fill preview shows of the buffer.
+    var cropWidth = bufferWidth
+    var cropHeight = Int((CGFloat(bufferWidth) / aspect).rounded())
+    if cropHeight > bufferHeight {
+      cropHeight = bufferHeight
+      cropWidth = min(bufferWidth, Int((CGFloat(bufferHeight) * aspect).rounded()))
+    }
+    let cropX = (bufferWidth - cropWidth) / 2
+    let cropY = (bufferHeight - cropHeight) / 2
+
+    var source = vImage_Buffer(
+      data: base.advanced(by: cropY * bytesPerRow + cropX * 4),
+      height: vImagePixelCount(cropHeight),
+      width: vImagePixelCount(cropWidth),
+      rowBytes: bytesPerRow
+    )
+
+    var result = Data(count: target.width * target.height * 4)
+    try result.withUnsafeMutableBytes { (bytes: UnsafeMutableRawBufferPointer) in
+      guard let out = bytes.baseAddress else {
+        throw CameraFrameTapFrameException("no output buffer")
+      }
+      var destination = vImage_Buffer(
+        data: out,
+        height: vImagePixelCount(target.height),
+        width: vImagePixelCount(target.width),
+        rowBytes: target.width * 4
+      )
+
+      if turn == 0 {
+        try check(vImageScale_ARGB8888(&source, &destination, nil, vImage_Flags(kvImageNoFlags)), "scale")
+      } else {
+        let scaled = UnsafeMutableRawPointer.allocate(
+          byteCount: scaledWidth * scaledHeight * 4,
+          alignment: MemoryLayout<UInt8>.alignment
+        )
+        defer { scaled.deallocate() }
+        var intermediate = vImage_Buffer(
+          data: scaled,
+          height: vImagePixelCount(scaledHeight),
+          width: vImagePixelCount(scaledWidth),
+          rowBytes: scaledWidth * 4
+        )
+        try check(vImageScale_ARGB8888(&source, &intermediate, nil, vImage_Flags(kvImageNoFlags)), "scale")
+        var background: [UInt8] = [0, 0, 0, 255]
+        // vImage counts quarter turns anticlockwise: 1 is a quarter turn
+        // anticlockwise, 3 a quarter turn clockwise.
+        let quarterTurns: UInt8 = turn == 90 ? 3 : turn == 180 ? 2 : 1
+        try check(
+          vImageRotate90_ARGB8888(&intermediate, &destination, quarterTurns, &background, vImage_Flags(kvImageNoFlags)),
+          "rotate"
+        )
+      }
+
+      // BGRA to RGBA, which is what the reader takes.
+      let order: [UInt8] = [2, 1, 0, 3]
+      try withUnsafePointer(to: &destination) { buffer in
+        try check(vImagePermuteChannels_ARGB8888(buffer, buffer, order, vImage_Flags(kvImageNoFlags)), "permute")
+      }
+    }
+    return NativeArrayBuffer.wrap(dataWithoutCopy: result)
+  }
+
+  private static func check(_ error: vImage_Error, _ step: String) throws {
+    if error != kvImageNoError {
+      throw CameraFrameTapFrameException("\(step) failed with vImage error \(error)")
+    }
+  }
+}
