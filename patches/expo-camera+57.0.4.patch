+/// The last capture-session interruption, for a failure that has to report it.
+///
+/// A static because the photo capture reports the failure and the session
+/// manager hears the interruption, and the two do not know about each other.
+/// `nonisolated(unsafe)` because it is one string written from a notification
+/// task and read on a capture callback; nothing branches on it.
+enum CameraSessionDiagnostics {
+  nonisolated(unsafe) static var lastInterruption = "none"
+
+  static func name(forReason reason: Int) -> String {
+    switch reason {
+    case 1: return "videoDeviceNotAvailableInBackground"
+    case 2: return "audioDeviceInUseByAnotherClient"
+    case 3: return "videoDeviceInUseByAnotherClient"
+    case 4: return "videoDeviceNotAvailableWithMultipleForegroundApps"
+    case 5: return "videoDeviceNotAvailableDueToSystemPressure"
+    default: return "unknown"
+    }
+  }
+}
